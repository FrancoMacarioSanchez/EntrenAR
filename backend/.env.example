DEBUG=1
SECRET_KEY=cambiar-por-un-valor-largo
ALLOWED_HOSTS=.localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://*.localhost:8082,http://localhost:8082,http://*.localhost:5173
BASE_DOMAIN=localhost
PUBLIC_PORT_SUFFIX=:8082

DB_NAME=entrenar
DB_USER=entrenar
DB_PASSWORD=entrenar
DB_HOST=localhost
DB_PORT=5434

# Email (por defecto se imprime en consola)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Notificaciones push (generar con: python manage.py vapid_keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:soporte@corex.com.ar

# Nutrición con IA (Gemini). Clave en https://aistudio.google.com/apikey
# Sin clave y con DEBUG=1 el análisis devuelve una respuesta de demostración.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_S=45
# GEMINI_FALLBACK_MODEL=   (opcional, otro modelo para reintentar si el principal no responde)
# Plug-in de IA: precio que CoreX cobra cada 1.000 tokens (ARS) y tope diario por alumno, por defecto
AI_PRICE_PER_1K_TOKENS=8
AI_DEFAULT_MAX_DAILY=10
# Para estimar el costo de Google y el margen en el admin
GEMINI_PRICE_INPUT_USD=0.75
GEMINI_PRICE_OUTPUT_USD=3.75
AI_FX_ARS=1570

# CoreX Hub (todo apagado si están vacías). Ver docs/HUB_INTEGRATION.md
COREX_AGENT_TOKEN=          # Hub -> EntrenAR (/corex/v1/): = "API token" del servicio EntrenAR en el Hub
HUB_URL=                    # EntrenAR -> Hub: p. ej. https://hub.corexit.tech
HUB_INGEST_TOKEN=           # = "token de ingesta" del servicio (lo imprime `corex_setup entrenar` en el Hub)
HUB_SSO_SECRET=
HUB_PORTAL_URL=
INVITE_DAYS=7               # vigencia del link para que el dueño defina su contraseña
# REDIS_URL=redis://127.0.0.1:6379/3   (producción: caché compartida entre workers)
# LOG_DIR=/var/log/entrenar
# ADMINS=franco@corexit.com.ar

SAAS_TRIAL_DAYS=14
SAAS_ALLOW_SIGNUP=1
